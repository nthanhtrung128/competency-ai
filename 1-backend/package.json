{
  "name": "competencyai-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx src/seed.ts",
    "seed:competencies": "tsx src/seed-competencies.ts",
    "smoke": "tsx src/smoke.ts",
    "postinstall": "prisma generate",
    "seed:job-architecture": "tsx src/seed-job-architecture.ts",
    "import:indicators": "tsx src/import-indicators.ts",
    "seed:all": "npm run seed && npm run seed:competencies && npm run seed:job-architecture",
    "backup": "tsx src/backup.ts",
    "db:push": "prisma db push",
    "test": "tsx tests/run.ts",
    "test:360": "tsx tests/e2e-360-idp.ts",
    "test:review": "tsx tests/e2e-review-succession.ts",
    "lint:tests": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "papaparse": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
