# Chuỗi kết nối Postgres — lấy từ Neon hoặc Supabase
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Bí mật ký token — BẮT BUỘC đổi trước khi deploy. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="doi-chuoi-nay-truoc-khi-deploy"
JWT_REFRESH_SECRET="doi-chuoi-khac-truoc-khi-deploy"

# Địa chỉ frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS="http://localhost:3000,https://ten-app-cua-ban.pages.dev"

# Mật khẩu tài khoản mẫu khi chạy seed
SEED_PASSWORD="Flamingo@2026"

PORT=8080
NODE_ENV=production
